# Normalize line endings: LF in the repo, checked out as-is on all platforms.
* text=auto eol=lf

# Rust and config sources are always LF.
*.rs      text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.sh      text eol=lf

# Windows scripts keep CRLF.
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Snapshot fixtures are treated as text.
*.snap    text eol=lf

# Binary assets.
*.png     binary
*.gif     binary
*.ico     binary
